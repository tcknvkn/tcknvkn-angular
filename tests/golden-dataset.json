  "rules": {
    "normalize": "Yalnizca bas/son bosluk kirpilir. Icerideki karakterler TEMIZLENMEZ.",
    "errorOrder": "length -> characters -> first_digit -> pattern -> checksum",
    "allSameDigits": "Tum haneleri ayni olan degerler gecersizdir (invalid_pattern), checksum tutsa bile. Etkilenen tek checksum-gecerli deger: VKN 4444444444.",
